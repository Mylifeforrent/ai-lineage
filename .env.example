# Clew 环境配置示例：复制为 .env 后填写，.env 不入库
# JWT 签名密钥，生产环境必须更换
SECRET_KEY=dev-secret-change-me
# JWT 有效期（小时）
JWT_EXPIRE_HOURS=24
# 数据目录：SQLite 库与托管源文件都存放于此
DATA_DIR=./data
# 首次启动且用户表为空时，自动创建的初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 单个源文件上传大小上限（MB），超限返回 413
MAX_UPLOAD_MB=50
# 允许跨域访问 API 的前端来源（逗号分隔；生产环境改为实际域名）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# LLM 供应商（M4 启用，OpenAI 兼容）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
