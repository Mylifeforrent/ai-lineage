# LineageLite 环境配置示例：复制为 .env 后填写，.env 不入库
# JWT 签名密钥，生产环境必须更换
SECRET_KEY=dev-secret-change-me
# JWT 有效期（小时）
JWT_EXPIRE_HOURS=24
# 数据目录：SQLite 库与托管源文件都存放于此
DATA_DIR=./data
# 首次启动且用户表为空时，自动创建的初始管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# LLM 供应商（M4 启用，OpenAI 兼容）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
